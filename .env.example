# -----------------------------------------------------------------------------
# .env.example — copy to `.env` and fill in your own values.
# `.env` is git-ignored (see .gitignore).
# -----------------------------------------------------------------------------

# ---- Postgres (analysis DB with tweets / entities / sentiment tables) --------
PGHOST=localhost
PGPORT=5432
PGDATABASE=twitter
PGUSER=postgres
PGPASSWORD=change-me

# ---- Twitter Academic Research Track (only needed to re-collect the corpus) --
# Discontinued 2023; leave blank if starting from released tweet IDs.
TWITTER_BEARER_TOKEN=

# ---- OpenAI (used only by src/absa/generate_acp_dataset.py) ------------------
OPENAI_API_KEY=

# ---- Ollama endpoint for local LLM topic labelling ---------------------------
OLLAMA_HOST=http://localhost:11434

# ---- Optional: Lato font path used by src/common.R for figure typography -----
LATO_FONT_PATH=
